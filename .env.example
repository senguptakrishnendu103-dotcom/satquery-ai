# ============================================================
# SatQuery AI Platform — Environment Configuration
# ============================================================

# Copernicus Data Space Ecosystem (CDSE) Credentials
# Create a free account at https://dataspace.copernicus.eu
# Required ONLY for downloading full raw satellite SAFE archives (.zip files)
CDSE_USERNAME=your_copernicus_username_or_email
CDSE_PASSWORD=your_copernicus_password

# Maximum upload size for satellite rasters in MB
SATQUERY_MAX_UPLOAD_MB=500
