# ============================================================
# SatQuery AI Platform — Environment Configuration
# ============================================================

# ISRO / NRSC Bhoonidhi Credentials (Optional for live web fetching)
# Register for free at https://bhoonidhi.nrsc.gov.in
BHOONIDHI_API_URL=https://bhoonidhi.nrsc.gov.in/api/v1
BHOONIDHI_USERNAME=your_bhoonidhi_username
BHOONIDHI_PASSWORD=your_bhoonidhi_password

# Maximum upload size for satellite rasters in MB
SATQUERY_MAX_UPLOAD_MB=500
